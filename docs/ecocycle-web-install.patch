@@ -0,0 +1,19 @@
+import { montarLayout } from '../../shared/layout.js';
+
+if (montarLayout()) {
+    const button = document.getElementById('install-app');
+    const message = document.getElementById('install-status');
+    let target;
+    try {
+        target = new URL(import.meta.env.VITE_CYCLO_URL);
+        const local = ['localhost', '127.0.0.1', '[::1]'].includes(target.hostname);
+        if ((target.protocol !== 'https:' && !(import.meta.env.DEV && local && target.protocol === 'http:')) ||
+            target.username || target.password || target.search || target.hash) throw new Error();
+        target.pathname = target.pathname.replace(/\/?$/, '/') + 'instalar.html';
+        message.textContent = 'Você será direcionado ao CYCLO para concluir a instalação no seu navegador.';
+        button.addEventListener('click', () => location.assign(target.href));
+    } catch {
+        button.disabled = true;
+        message.textContent = 'Instalação temporariamente indisponível. Entre em contato com a equipe EcoCycle.';
+    }
+}
